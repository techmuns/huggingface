# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Wrangler reads EITHER `.dev.vars` OR `.env` for local dev, never both: if a
# `.dev.vars` file exists, `.env` is ignored entirely. This project uses
# `.env`, so do not create a `.dev.vars` or these values will silently stop
# being applied.
#
# For deployed environments these are not files. Set each one with:
#     npx wrangler secret put <NAME>

# Hugging Face token. The Hub API is public and needs no auth; a token only
# raises the rate limit above the anonymous 500 requests / 5 minutes.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon Bedrock long-term API key (starts with `ABSK`). Sent as a bearer
# token — no SigV4 signing, no AWS key pair, no aws4fetch dependency.
BEDROCK_API_KEY=ABSKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub token with contents:write on GITHUB_REPO, used to commit the weekly
# snapshot JSON under data/weeks/. Needed from Phase 8 onward.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer token guarding the manual pipeline trigger and the review queue.
# Any long random string. Needed from Phase 9 onward.
ADMIN_TOKEN=

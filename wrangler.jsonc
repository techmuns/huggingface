{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huggingface",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // ---------------------------------------------------------------------
  // What this Worker is, now.
  //
  // A page and a health check. It has no database, no Workflow, no cron and
  // no secrets, because it no longer computes anything: the weekly run does
  // that on a GitHub-hosted runner and writes its answers into public/data,
  // which ships with this deploy as static assets.
  //
  // That is why there is no "limits" block. `limits.cpu_ms` is a Workers PAID
  // feature and setting it on this account fails the deploy outright —
  //
  //     CPU limits are not supported for the Free plan  [code: 100328]
  //
  // — which is how it was found, with four unrelated fixes sitting undeployed
  // behind one line. It was added to buy CPU for the pipeline. The pipeline
  // left instead, and serving a file needs none.
  // ---------------------------------------------------------------------

  // Which code is actually live. A push and its deploy are minutes apart, and
  // reading the dashboard inside that gap shows the previous build with
  // nothing on the page to say so. /health reports this so the question is
  // answerable.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------------
  // Static assets — the dashboard page and the data it reads.
  //
  // `not_found_handling: "none"` lets unmatched paths fall through to the
  // fetch handler instead of returning the asset 404. Two paths depend on
  // that: /health, and the 410 for the retired /api/* routes.
  //
  // A missing file under /data IS the 404 the page expects — a week with no
  // narrative has no narrative file, and the card hides itself on a 404. So
  // the asset router answering those directly is the intended behaviour, not
  // a gap.
  // ---------------------------------------------------------------------
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // ---------------------------------------------------------------------
  // No "triggers" block, and now nothing to trigger.
  //
  // The schedule is .github/workflows/weekly-runner.yml. This file used to
  // declare an identical cron, which was harmless only by accident: all five
  // Free-plan cron slots were in use, so the deploy silently dropped the
  // schedule — and marked every Workers Build failed for it, even though the
  // code went live. The Worker has no scheduled() handler any more, so a
  // trigger here would fire into nothing.
  // ---------------------------------------------------------------------

  // No "secrets" block either. HF_TOKEN, BEDROCK_API_KEY and GITHUB_TOKEN
  // moved to GitHub Actions secrets with the pipeline; ADMIN_TOKEN guarded
  // the admin endpoints and went with them. Nothing this Worker does needs a
  // credential.

  "vars": {
    "TAXONOMY_VERSION": "1"
  }
}
